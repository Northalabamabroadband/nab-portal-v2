APP_ENV=development
APP_NAME=NAB Mission Control
APP_VERSION=2.0.0-rc1-build024
APP_SECRET_KEY=replace-with-a-long-random-value
DATABASE_URL=postgresql+psycopg://nab_portal:nab_portal@postgres:5432/nab_portal
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=http://localhost:8200,http://localhost:8300
LOG_LEVEL=INFO
SESSION_TTL_SECONDS=43200
BOOTSTRAP_ADMIN_EMAIL=admin@nabroadband.com
BOOTSTRAP_ADMIN_PASSWORD=change-this-immediately

UISP_BASE_URL=https://100.80.1.189
UISP_API_TOKEN=
UISP_VERIFY_TLS=false
UISP_TIMEOUT_SECONDS=20

TAUC_BASE_URL=https://use1-tauc-openapi.tplinkcloud.com
TAUC_ACCESS_KEY=
TAUC_SECRET_KEY=
TAUC_CLIENT_CERT=/run/secrets/tauc/client.crt
TAUC_CLIENT_KEY=/run/secrets/tauc/client.key
TAUC_VERIFY_TLS=true
TAUC_TIMEOUT_SECONDS=20
TAUC_MIN_REQUEST_INTERVAL_SECONDS=1.35
TAUC_RATE_LIMIT_BACKOFF_SECONDS=3
TAUC_SNAPSHOT_CACHE_SECONDS=15
TAUC_DEVICE_LOOKUP_PATH=/v1/openapi/device-information/device-id
TAUC_NETWORK_LOOKUP_PATH=/v1/openapi/device-information/device-info
TAUC_NETWORK_ID_LOOKUP_PATH=/v1/openapi/network-system-management/id
TAUC_NETWORK_LIST_PATH=/v1/openapi/network-system-management/network-name-list
TAUC_WIFI_SSID_READ_PATH=/v1/openapi/device-management/aginet/wifi-ssid
# Network-scoped connected-client telemetry. Supports {network_id}/{networkId};
# device-scoped tenant variants may use {device_id}/{deviceId}.
TAUC_NETWORK_CLIENTS_PATH=/v1/openapi/network-data-collection/network-clients/{network_id}
# Provider diagnostics is optional; the portal snapshot works without it.
# Leave write paths blank until verified against your TAUC tenant API contract.
TAUC_WIFI_SSID_UPDATE_PATH=
TAUC_WIFI_PASSWORD_UPDATE_PATH=
TAUC_REBOOT_PATH=
TAUC_DIAGNOSTICS_PATH=

UISP_CRM_BASE_URL=
UISP_CRM_API_TOKEN=
UISP_NMS_BASE_URL=
UISP_NMS_API_TOKEN=
UISP_AUTH_MODE=app-key
UISP_CRM_AUTH_MODE=
UISP_NMS_AUTH_MODE=
UISP_NMS_DEVICES_PATH=/nms/api/v2.1/devices
UISP_NMS_SITES_PATH=/nms/api/v2.1/sites
TAUC_TEST_SERIAL_NUMBER=
TAUC_TEST_MAC_ADDRESS=
